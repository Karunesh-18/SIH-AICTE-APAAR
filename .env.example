# Copy to .env. Never commit .env. All values here are demo defaults, not secrets.
DATABASE_URL=sqlite:///./apaar.db
# HS256 secret for access/refresh tokens. Replace outside local demos.
JWT_SECRET=change-me-in-any-shared-environment
DEMO_MODE=true
# Ed25519 key for signed verification results is generated at first run into backend/keys/ (gitignored).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Email: console (default, logs only, no network) or smtp. smtp refuses to start without SMTP_HOST and EMAIL_FROM.
# Set these in backend/.env (never commit it). Tested against a fake SMTP server only.
# EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=
